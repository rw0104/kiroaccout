{
  "name": "kiro-account-manager",
  "version": "1.8.8",
  "description": "Kiro Account Manager - Manage your Kiro accounts, usage and subscriptions",
  "main": "./out/main/index.js",
  "author": "rw0104",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/rw0104/kiroaccout",
  "repository": {
    "type": "git",
    "url": "https://github.com/rw0104/kiroaccout.git"
  },
  "bugs": {
    "url": "https://github.com/rw0104/kiroaccout/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "chcp 65001 >nul && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "node scripts/verify-native-deps.mjs",
    "build:unpack": "npm run build && npm run prepare:resources && electron-builder --dir --publish never",
    "build:win": "npm run build && npm run prepare:resources -- --platform win32 --arch x64 && npm run package:win",
    "package:win": "electron-builder --win nsis zip --x64 --publish never",
    "package:mac": "electron-builder --mac dmg zip --publish never",
    "package:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "prepare:resources": "node scripts/prepare-platform-resources.mjs",
    "verify:package": "node scripts/verify-platform-package.mjs --platform win32 --arch x64",
    "verify:platform": "node scripts/verify-platform-package.mjs",
    "release:checksums": "node scripts/release-checksums.mjs",
    "release:stage": "node scripts/stage-release.mjs",
    "build:mac": "npm run build && npm run prepare:resources -- --platform darwin && npm run package:mac",
    "build:linux": "npm run build && npm run prepare:resources -- --platform linux --arch x64 && npm run package:linux",
    "test:unit": "node --disable-warning=ExperimentalWarning --import ./test/unit/register-ts-resolve.mjs --test test/unit/*.test.ts test/unit/*.test.mjs",
    "test:e2e": "node test/e2e-fullsuite/run.mjs",
    "test:e2e:only": "node test/e2e-fullsuite/run.mjs --only"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-virtual": "^3.13.12",
    "cbor-x": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12.40.0",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^0.555.0",
    "node-forge": "^1.3.3",
    "socks": "^2.8.9",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tlsclientwrapper": "^4.2.0",
    "undici": "^7.19.2",
    "uuid": "^13.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.6"
  }
}
